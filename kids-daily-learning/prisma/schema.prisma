// Kids Daily Learning — PostgreSQL schema (Prisma)
//
// Privacy by design: a Child row holds only a display name, an age and an
// emoji avatar. No birthday, surname, photo, school or location is stored.
// Everything about a child is reachable only through its Parent, and every
// API route checks child.parentId === session.parentId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────── People & access

enum Role {
  PARENT
  ADMIN
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  role           Role     @default(PARENT)
  /// Bump to invalidate every issued session (log out everywhere, password change).
  sessionVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  parent         Parent?
}

model Parent {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String          @db.VarChar(40)
  createdAt     DateTime        @default(now())
  children      Child[]
  settings      ParentSettings?
  notifications Notification[]
}

model ParentSettings {
  id             String  @id @default(cuid())
  parentId       String  @unique
  parent         Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  notifyActivity Boolean @default(true)
  notifyBadge    Boolean @default(true)
  notifyGoal     Boolean @default(true)
  /// bcrypt hash of the optional 4-digit parent PIN
  pinHash        String?
  /// IANA zone used to decide a child's "today" (streaks, goals)
  timeZone       String  @default("UTC")
}

model Child {
  id           String         @id @default(cuid())
  parentId     String
  parent       Parent         @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name         String         @db.VarChar(20)
  age          Int            @db.SmallInt
  avatar       String         @db.VarChar(16)
  createdAt    DateTime       @default(now())
  settings     ChildSettings?
  attempts     QuizAttempt[]
  progress     Progress[]
  xpEvents     XpEvent[]
  starEvents   StarEvent[]
  badges       ChildBadge[]
  streak       DailyStreak?
  usage        DailyUsage[]
  achievements Achievement[]
  notifications Notification[]

  @@index([parentId])
}

/// Parent controls for one child.
model ChildSettings {
  id                String   @id @default(cuid())
  childId           String   @unique
  child             Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  dailyGoal         Int      @default(5) @db.SmallInt
  screenTimeMinutes Int      @default(45) @db.SmallInt
  allowedTracks     String[] @default(["english", "math", "science", "gk", "story", "brain", "creativity", "habit"])
  aiEnabled         Boolean  @default(true)
  soundOn           Boolean  @default(true)
  largeText         Boolean  @default(false)
}

// ─────────────────────────────────────────────────────────── Curriculum (admin-managed)

model AgeGroup {
  id        String @id @default(cuid())
  slug      String @unique
  label     String
  minAge    Int    @db.SmallInt
  maxAge    Int    @db.SmallInt
  baseLevel Int    @db.SmallInt
}

model Subject {
  id        String   @id // "english" | "math" | "science" | "gk" | "creativity" | "habits"
  name      String
  icon      String
  color     String
  enabled   Boolean  @default(true)
  topics    String[]
  sortOrder Int      @default(0)
  lessons   Lesson[]
  activities Activity[]
}

enum LessonKind {
  KNOWLEDGE_UNIT // science / general-knowledge unit: fact cards + questions
  VOCAB_WORD // one vocabulary word (word, emoji, meaning, example)
}

model Lesson {
  id        String     @id @default(cuid())
  slug      String     @unique
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id])
  kind      LessonKind
  title     String
  icon      String
  topic     String?
  level     Int        @db.SmallInt
  /// KNOWLEDGE_UNIT: LessonCard[]; VOCAB_WORD: { meaning, example }
  data      Json
  published Boolean    @default(true)
  questions Question[]
  updatedAt DateTime   @updatedAt

  @@index([subjectId, level])
}

enum ActivityTemplateKind {
  CREATIVE
  HABIT
}

/// Creative prompts and good-habit challenges. Quiz activities are generated by
/// the engine (src/core/engine) from lessons, stories and generators.
model Activity {
  id        String               @id @default(cuid())
  slug      String               @unique
  subjectId String
  subject   Subject              @relation(fields: [subjectId], references: [id])
  kind      ActivityTemplateKind
  title     String
  icon      String
  body      String               // prompt (creative) or why-it-matters (habit)
  steps     String[]             // tips (creative) or steps (habit)
  minAge    Int                  @db.SmallInt
  published Boolean              @default(true)
}

model Story {
  id         String     @id @default(cuid())
  slug       String     @unique
  title      String
  minAge     Int        @db.SmallInt
  maxAge     Int        @db.SmallInt
  scene      String     // illustration placeholder (emoji scene); swap for imageUrl when art exists
  sceneColor String
  imageUrl   String?
  paragraphs String[]
  moral      String
  published  Boolean    @default(true)
  questions  Question[]
  updatedAt  DateTime   @updatedAt
}

model Question {
  id        String       @id @default(cuid())
  slug      String       @unique
  lessonId  String?
  lesson    Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  storyId   String?
  story     Story?       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  /// "mc" | "tf" | "image" | "match" | "type" | "order" (validated by zod in the admin API)
  type      String       @db.VarChar(8)
  prompt    String
  visual    String?
  explain   String
  /// Type-specific payload: options/answer, pairs, accept[], items[]
  payload   Json
  sortOrder Int          @default(0)

  @@index([lessonId])
  @@index([storyId])
}

model Badge {
  id          String       @id // e.g. "streak-7"
  name        String
  icon        String
  description String
  /// BadgeRule JSON, e.g. {"kind":"track","track":"math","count":5}
  rule        Json
  sortOrder   Int          @default(0)
  children    ChildBadge[]
}

// ─────────────────────────────────────────────────────────── Learning records

/// One finished activity (quiz, story, game, creative or habit).
model QuizAttempt {
  id          String   @id @default(cuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  /// Engine activity id, e.g. "d.2026-09-24.math" — rebuildable server-side
  activityId  String   @db.VarChar(120)
  track       String   @db.VarChar(16)
  subjectId   String   @db.VarChar(16)
  title       String
  icon        String
  day         String   @db.Char(10) // child's local YYYY-MM-DD
  correct     Int      @db.SmallInt
  total       Int      @db.SmallInt
  scorePct    Int?     @db.SmallInt
  stars       Int      @db.SmallInt
  xp          Int      @db.SmallInt
  seconds     Int
  repeat      Boolean  @default(false)
  completedAt DateTime @default(now())
  answers     Answer[]

  @@index([childId, completedAt])
  @@index([childId, day])
  @@index([childId, track])
}

/// A child's response to one question inside an attempt.
model Answer {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String      @db.VarChar(160)
  response   Json
  correct    Boolean

  @@index([attemptId])
}

/// Denormalized mastery per child & track for fast dashboards.
model Progress {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  track     String   @db.VarChar(16)
  mastery   Int?     @db.SmallInt
  level     Int      @db.SmallInt
  completed Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([childId, track])
}

model XpEvent {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  amount    Int      @db.SmallInt
  reason    String   @db.VarChar(40)
  attemptId String?
  createdAt DateTime @default(now())

  @@index([childId])
}

model StarEvent {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  amount    Int      @db.SmallInt
  attemptId String?
  createdAt DateTime @default(now())

  @@index([childId])
}

model ChildBadge {
  id         String   @id @default(cuid())
  childId    String
  child      Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  badgeId    String
  badge      Badge    @relation(fields: [badgeId], references: [id])
  unlockedAt DateTime @default(now())

  @@unique([childId, badgeId])
}

model DailyStreak {
  id      String  @id @default(cuid())
  childId String  @unique
  child   Child   @relation(fields: [childId], references: [id], onDelete: Cascade)
  current Int     @default(0)
  longest Int     @default(0)
  lastDay String? @db.Char(10)
}

/// Screen-time seconds per child per local day.
model DailyUsage {
  id      String @id @default(cuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  day     String @db.Char(10)
  seconds Int    @default(0)

  @@unique([childId, day])
}

enum AchievementKind {
  GOAL_MET
  STREAK_MILESTONE
  PERFECT_SCORE
}

/// Milestones worth celebrating (used for timelines and weekly summaries).
model Achievement {
  id        String          @id @default(cuid())
  childId   String
  child     Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  kind      AchievementKind
  day       String          @db.Char(10)
  detail    String
  createdAt DateTime        @default(now())

  @@index([childId, day])
}

enum NotificationKind {
  activity
  badge
  goal
  safety // always delivered; not user-disableable
}

model Notification {
  id        String           @id @default(cuid())
  parentId  String
  parent    Parent           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  childId   String
  child     Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  text      String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([parentId, createdAt])
}
