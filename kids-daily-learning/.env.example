# ── Database (PostgreSQL) ───────────────────────────────────────────
DATABASE_URL="postgresql://kdl:kdl@localhost:5432/kids_daily_learning?schema=public"

# ── Auth ─────────────────────────────────────────────────────────────
# 32+ random characters, e.g.  openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-secret-string-000000"

# ── Data mode ────────────────────────────────────────────────────────
# api  = production (API routes + PostgreSQL)
# mock = in-browser demo data, no database needed
NEXT_PUBLIC_DATA_MODE="api"

# ── Buddy AI ─────────────────────────────────────────────────────────
# mock = offline teaching replies; anthropic = Claude via the Messages API
BUDDY_PROVIDER="mock"
ANTHROPIC_API_KEY=""
BUDDY_MODEL="claude-haiku-4-5-20251001"
